// Xcode の GUI で設定するとプロジェクトファイルに焼き込まれて読みにくくなるので、
// ビルド設定はできるだけここに出す。pbxproj 側には構成（Debug / Release）で
// 差がある設定だけを残す。
//
// この方針の裏返しとして、iosApp の設定は Xcode の GUI ではなくこのファイルか
// pbxproj の直編集で行う。GUI で保存すると pbxproj 全体が書き直されて差分が読めなくなる
//
// **コメントにも実値を書かないこと。** 説明のつもりの 1 行でも public に出るのは同じ。
// そのうえで、説明で設定名を出すときは直後に `=` を書かない——実値を書いた例示と
// 区別できないので、scripts/check-ios-signing.py が鳴る

// 手元ごとに変わる値はここでは空にし、末尾で読む Local.xcconfig に各自が置く。
// 空のままでもシミュレータのビルドは通る
TEAM_ID =

BUNDLE_ID = io.github.obaya884.rebuy
APP_NAME = ReBuy

// Run Script が $SRCROOT/.. の Gradle を呼ぶので、スクリプトのサンドボックスを切る。
// Xcode 15 以降のテンプレートはこれを YES で作るため、明示しないと
// 「Update to recommended settings」を当てた瞬間に読み取り拒否で落ちる
ENABLE_USER_SCRIPT_SANDBOXING = NO

// バージョンの出所をここ 1 か所にし、Info.plist は $(MARKETING_VERSION) で引く。
// Android は gradle.properties の rebuy.versionName が出所なので、いまは手で揃える
MARKETING_VERSION = 0.0.1
CURRENT_PROJECT_VERSION = 1

// 明示しないと従来形式の headermap を使うと警告が出る
ALWAYS_SEARCH_USER_PATHS = NO

SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// Kotlin 側は iosArm64 と iosSimulatorArm64 の 2 つしか作っていない（iosX64 は
// Intel Mac のシミュレータ用で、開発機も GitHub の macOS ランナーも arm64）。
// 絞らないと `-destination 'generic/platform=iOS Simulator'` が x86_64 も要求し、
// Gradle 側が `Unknown iOS simulator arch: 'x86_64'` で落ちる（CI で実測）
ARCHS = arm64
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0

// Kotlin の framework の受け渡し場所。Run Script が
// :shared:ui:embedAndSignAppleFrameworkForXcode でここへ置く。
// **framework は debug しか作っていないので、Release 構成は段 4 まで通らない**
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../shared/ui/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)
OTHER_LDFLAGS = $(inherited) -framework ReBuyUi

PRODUCT_NAME = $(APP_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID)
DEVELOPMENT_TEAM = $(TEAM_ID)
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = iosApp/Info.plist
ENABLE_PREVIEWS = YES

// 手元だけの上書き。`?` 付きなのでファイルが無くても失敗しない。
//
// **参照は使う時点で解決される**ので、TEAM_ID を入れるだけならこの行の位置は
// 問わない（上にある DEVELOPMENT_TEAM への代入にも後から効く）。位置が効くのは
// Local が DEVELOPMENT_TEAM や BUNDLE_ID を直に書いた場合で、**後で定義した値が
// 勝つ**ため、どの設定も上書きできるようファイルの末尾に置く
#include? "Local.xcconfig"
